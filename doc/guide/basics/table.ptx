<table>
  <title>A simple table</title>
  <tabular halign="center">
    <row header="yes" bottom="minor" >
      <cell>Variable <m>x</m></cell>
      <cell>Variable <m>y</m></cell>
      <cell>Conjunction <m>x\wedge y</m></cell>
      <cell>Disjunction <m>x\vee y</m></cell>
    </row>
    <row>
      <cell>T</cell>
      <cell>T</cell>
      <cell>T</cell>
      <cell>T</cell>
    </row>
    <row>
      <cell>T</cell>
      <cell>F</cell>
      <cell>F</cell>
      <cell>T</cell>
    </row>
    <row>
      <cell>F</cell>
      <cell>T</cell>
      <cell>F</cell>
      <cell>T</cell>
    </row>
    <row>
      <cell>F</cell>
      <cell>F</cell>
      <cell>F</cell>
      <cell>F</cell>
    </row>
  </tabular>

</table>

