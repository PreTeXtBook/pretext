<!-- The sample research article, for the journal "springer-nature". -->
<!-- The numbering below is the same in every publication file of    -->
<!-- this example.  A journal whose style has a numbering of its     -->
<!-- own replaces it, and a warning reports each level that differs. -->

<publication>

    <common>
        <!-- Springer Nature journals; the sn-jnl class -->
        <journal name="springer-nature"/>
    </common>

    <numbering>
        <divisions level="2"/>
        <blocks level="1"/>
        <equations level="1"/>
    </numbering>

</publication>
